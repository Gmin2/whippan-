# the film API. every value here is optional; these are the defaults.
PORT=8903
# NODE_ENV=production narrows CORS to CORS_ORIGINS, which is then required
# CORS_ORIGINS=https://boards.example.com

# films come from postgres when this is set, and from DOCS_DIR when it is not.
# locally: docker compose up -d, then npx tsx src/db/import.ts
# DATABASE_URL=postgres://whippan:whippan@localhost:5433/whippan
# PG_MAX=5

# only read by the importer once DATABASE_URL is set
# DOCS_DIR=/data/docs

# accounts are off until there is a secret to sign sessions with. generate one:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:8903
# the editor's origin, allowed to hold a session cookie
# AUTH_TRUSTED_ORIGINS=http://localhost:8902
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# uploaded images and rendered mp4s. azure blob when a connection string is
# set, a directory otherwise. locally, docker compose runs azurite:
# STORAGE_CONNECTION=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# STORAGE_DIR=/data/blob

# the compiled native renderer, and where finished mp4s land
# EXPORT_BIN=/app/bin/export
# EXPORT_CWD=/app
# EXPORT_DIR=/data/exports
# EXPORT_CONCURRENCY=2

# the prompt bar. each key is independent: without one, that action reports
# itself as unavailable in the UI rather than failing when you press the button.
# motion, which writes anim.json tracks
# ANTHROPIC_API_KEY=
# images, google's nano banana
# GEMINI_API_KEY=
# vectors, quiverai's arrow
# QUIVERAI_API_KEY=

# point a provider at a proxy, a regional endpoint or a test double
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# QUIVERAI_BASE_URL=https://api.quiver.ai/v1/svgs/generations
